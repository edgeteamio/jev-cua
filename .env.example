# Copy to the secrets file this project reads (same name without .example) and fill in.
# Required: every Jev decision.
TYPESAFE_API_KEY=
# Optional: serve Jev through Vercel AI Gateway instead (same requests and answers, billed in
# Vercel). Set JEV_ENDPOINT=gateway and an AI Gateway key; TYPESAFE_API_KEY is then unused.
# JEV_GATEWAY_MODEL overrides the gateway's model ID (default typesafe-ai/jev).
JEV_ENDPOINT=
AI_GATEWAY_API_KEY=
JEV_GATEWAY_MODEL=
# Optional: goal-mode escalation (planner, writer, composer). Absent means escalation off.
ANTHROPIC_API_KEY=
